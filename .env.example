# Firebase client configuration. These values are public client identifiers,
# not server secrets. Never place private keys in EXPO_PUBLIC_ variables.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_EXPO_PROJECT_ID=
# Optional client-restricted key used only by the native Google Maps SDK on Android.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
# Optional override for local emulators or a regional Firebase Functions URL.
EXPO_PUBLIC_ROUTE_FUNCTION_URL=
